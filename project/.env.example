APP_NAME="MOEHE-EastGaza-ComputerDept"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://localhost

# Display timezone for the frontend is Asia/Gaza per D-36; the API itself always
# stores and returns UTC ISO-8601 timestamps (see Batch 3 §1 "التاريخ والوقت").
DISPLAY_TIMEZONE=Asia/Gaza

LOG_CHANNEL=stack
LOG_LEVEL=info
# Never log request/response bodies for auth endpoints (mfa_secret, password, tokens).

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=moehe_computer_dept
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

SANCTUM_STATEFUL_DOMAINS=

# --- M1 security / policy settings (initial values; see settings table for
# the live, admin-editable copies — these env vars are only used as seed defaults) ---
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_INACTIVITY_MINUTES=30
AUTH_TOKEN_TTL_MINUTES=480
AUTH_MFA_CHALLENGE_TTL_MINUTES=5
AUTH_MIN_PASSWORD_LENGTH=5

# TOTP secrets are encrypted at rest using APP_KEY (Laravel encrypted casting).
# Never commit a real APP_KEY or any secret value to Git.

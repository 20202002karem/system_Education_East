{
    "name": "moehe-gaza-east/computer-dept-m1",
    "type": "project",
    "description": "M1 - Identity & Access, Organization, Settings & Reference Data, Audit & Integrity - Directorate of Education East Gaza, Computer Department System",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.56",
        "laravel/sanctum": "^4.0",
        "pragmarx/google2fa": "^8.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "laravel/tinker": "^3.0",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "php artisan test"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
